{
  "identifier": "zy2755-browser-ref-mcp",
  "name": "Browser Ref MCP",
  "version": "0.1.1",
  "author": "zy2755",
  "authorUrl": "https://github.com/zy2755",
  "category": "developer",
  "description": "Reliable browser-control MCP server for AI agents: click by ref, self-healing sessions.",
  "homepage": "https://github.com/zy2755/browser-ref-mcp",
  "icon": "https://gcore.jsdelivr.net/gh/zy2755/browser-ref-mcp@main/plugin/logo.png",
  "tags": [
    "browser-automation",
    "browser-control",
    "playwright",
    "web-scraping",
    "ai-agent",
    "chrome",
    "edge"
  ],
  "localizations": [
    {
      "locale": "zh-CN",
      "name": "浏览器 Ref 控制",
      "description": "让 AI 直接操作你本机已有的 Chrome/Edge：页面快照带编号 ref，按 ref 点击而不靠易碎的 CSS 选择器，浏览器挂了下次调用自动重启并恢复标签页。"
    }
  ],
  "tools": [
    {
      "name": "browser_navigate",
      "description": "导航到 URL,返回后自动附带页面交互元素快照(带 [eN] ref 编号,可直接用于 click/type)。缺协议时自动补 https://。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "目标 URL"
          },
          "newTab": {
            "type": "boolean",
            "description": "是否在新标签页打开(默认 false,当前页导航)"
          },
          "timeoutMs": {
            "type": "number",
            "description": "导航超时毫秒数(默认 30000)"
          },
          "snapshot": {
            "type": "boolean",
            "description": "是否在结果中附快照(默认 true)"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "browser_snapshot",
      "description": "获取当前页面语义快照:交互元素带 [eN] ref 编号(iframe 内容已拍平)。支持 rootRef(只看某元素子树)、selector、filter:\"interactive\" 只看交互元素。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "string",
            "enum": [
              "balanced",
              "interactive",
              "text"
            ]
          },
          "rootRef": {
            "type": "string",
            "description": "只快照该 ref 元素的子树"
          },
          "selector": {
            "type": "string",
            "description": "只快照匹配该 CSS 选择器的子树(主文档)"
          },
          "maxElements": {
            "type": "number",
            "description": "最多输出行数(默认 400)"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "browser_click",
      "description": "点击元素(优先用快照里的 ref)。自动等待可操作、自动重解析失效 ref、点击后自动附最新快照。特殊对话框会自动处理并上报。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "description": "快照中的 [eN] 编号"
          },
          "selector": {
            "type": "string",
            "description": "CSS 选择器(ref 不可用时的兜底)"
          },
          "text": {
            "type": "string",
            "description": "按可见文本匹配"
          },
          "button": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "middle"
            ]
          },
          "doubleClick": {
            "type": "boolean"
          },
          "timeoutMs": {
            "type": "number"
          },
          "snapshot": {
            "type": "boolean",
            "description": "点击后是否附快照(默认 true)"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "browser_type",
      "description": "向输入框输入文本(先清空再输入)。submit:true 时回车提交。适用于 input/textarea/contenteditable。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "description": "要输入的文本"
          },
          "submit": {
            "type": "boolean",
            "description": "输入后按 Enter(默认 false)"
          },
          "clear": {
            "type": "boolean",
            "description": "是否先清空(默认 true;false 则追加)"
          },
          "timeoutMs": {
            "type": "number"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "browser_press_key",
      "description": "按下键盘按键,如 Enter / Tab / ArrowDown / \"Control+a\"。带 ref 时先聚焦该元素。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "键名,如 Enter、Escape、ArrowDown、Control+a"
          },
          "ref": {
            "type": "string",
            "description": "先聚焦此元素再按键"
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "browser_select_option",
      "description": "在下拉框(select)中选中选项。values 可为 value 或可见 label,自动两轮匹配。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "要选中的 value/label 列表"
          },
          "timeoutMs": {
            "type": "number"
          }
        },
        "required": [
          "values"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "browser_hover",
      "description": "鼠标悬停到元素上(触发悬浮菜单/tooltip)。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "browser_scroll",
      "description": "滚动页面或指定滚动容器(带 ref 时滚动该容器)。方向 + 像素量。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "direction": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "left",
              "right"
            ]
          },
          "amount": {
            "type": "number",
            "description": "滚动像素(默认 600)"
          },
          "ref": {
            "type": "string",
            "description": "滚动该容器(快照中带 [可滚动] 标记的元素)"
          }
        },
        "required": [
          "direction"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "browser_screenshot",
      "description": "截屏并保存到本地,返回图片(供多模态查看)。可整页、可视区或单元素(ref)。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fullPage": {
            "type": "boolean",
            "description": "整页截图(默认只截可视区)"
          },
          "ref": {
            "type": "string",
            "description": "只截该元素"
          },
          "filename": {
            "type": "string",
            "description": "文件名(不含扩展名,默认时间戳)"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "browser_evaluate",
      "description": "逃生舱:在页面里执行 JS 并返回 JSON 可序列化结果。传函数字符串如 `() => document.title` 或 `() => {...}`;带 ref 时在该元素上执行(`(el, ) => el.value`)。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "js": {
            "type": "string",
            "description": "函数字符串,如 `() => document.querySelector('#app')?.innerText.slice(0,2000)`"
          },
          "ref": {
            "type": "string",
            "description": "在该元素上执行,回调第一个参数是元素"
          }
        },
        "required": [
          "js"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "browser_wait",
      "description": "等待条件成立:timeMs 固定时长 / text 文本出现 / selector 元素出现 / url 跳转 / idle 网络空闲。可组合。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "timeMs": {
            "type": "number"
          },
          "text": {
            "type": "string",
            "description": "等待该文本出现在页面上"
          },
          "selector": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "等待 URL 变为该模式"
          },
          "idle": {
            "type": "boolean",
            "description": "等待网络空闲(最长 15s)"
          },
          "timeoutMs": {
            "type": "number",
            "description": "等待超时(默认 15000)"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "browser_tabs",
      "description": "多标签管理:list 列出 / new 新建 / select 切换(按 list 显示的 index 或 id)/ close 关闭。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "new",
              "select",
              "close"
            ]
          },
          "url": {
            "type": "string",
            "description": "new 时打开的 URL(可选)"
          },
          "index": {
            "type": "number",
            "description": "select/close 的目标标签序号(见 list 输出,0 起)"
          },
          "id": {
            "type": "string",
            "description": "select/close 的目标标签 pageId"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "browser_get_info",
      "description": "查询浏览器健康状态:模式、标签列表、重启次数、最近错误/对话框/下载。不会启动浏览器。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "browser_close",
      "description": "关闭浏览器(launch 模式下整个浏览器退出,profile 登录态保留;connect 模式只断开连接)。下次工具调用会自动重启。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
  "resources": [],
  "prompts": []
}
