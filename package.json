{
  "name": "browser-ref-mcp",
  "version": "0.1.1",
  "description": "Reliable browser-control MCP server for AI agents: click by ref, self-healing sessions.",
  "mcpName": "io.github.zy2755/browser-ref-mcp",
  "type": "module",
  "bin": {
    "browser-ref-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "serve:fixtures": "node test/serve.mjs",
    "smoke": "node test/smoke.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "check-version": "node scripts/sync-version.mjs --check",
    "version": "node scripts/sync-version.mjs && git add .claude-plugin/marketplace.json plugin/.claude-plugin/plugin.json server.json"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "browser-automation",
    "browser-control",
    "playwright",
    "ai-agent",
    "claude",
    "cursor",
    "web-scraping"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zy2755/browser-ref-mcp.git"
  },
  "homepage": "https://github.com/zy2755/browser-ref-mcp#readme",
  "bugs": {
    "url": "https://github.com/zy2755/browser-ref-mcp/issues"
  },
  "author": "zy2755",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright-core": "^1.53.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
